---
interface Props {
  isCentered?: boolean;
}

const { isCentered = true } = Astro.props;
---

<h2 class:list={["title", isCentered && "center"]}><slot /></h2>

<style>
  .title {
    font-weight: 700;
    font-size: 46px;
    line-height: 80%;
    text-transform: lowercase;
    color: var(--color-text-primary);

    &.center {
      text-align: center;
    }

    /* widescreen */
    @media (width >= 1200px) {
      font-size: 75px;
    }
  }
</style>
