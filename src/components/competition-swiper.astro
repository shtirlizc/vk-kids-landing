---
import DrawingInfo from "./drawing-info.astro";

interface Creator {
  contactName: string;
  artistFirstName: string;
  contactHref?: string;
}

interface SlideImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Slide {
  images: SlideImage[];
  creator: Creator;
}

interface Props {
  slides: Slide[];
  text: string;
}

const { slides, text } = Astro.props;
const hasNavigation = slides.length > 1;
const hasNestedNavigation = slides.some(({ images }) => images.length > 1);
---

<div
  class="competition-swiper"
  data-competition-swiper
  data-loop={hasNavigation}
>
  <div class="competition-swiper__content">
    <div class="competition-swiper__media" data-competition-lightbox>
      <div class="swiper competition-swiper__main" data-competition-main>
        <div class="swiper-wrapper competition-swiper__full-height">
          {
            slides.map(({ images }, slideIndex) => (
              <div class="swiper-slide competition-swiper__full-height">
                {images.length > 1 ? (
                  <div class="competition-swiper__nested competition-swiper__full-height">
                    <div
                      class="swiper competition-swiper__nested-swiper competition-swiper__full-height"
                      data-competition-nested
                    >
                      <div class="swiper-wrapper competition-swiper__full-height">
                        {images.map(
                          ({ src, alt, width, height }, imageIndex) => (
                            <div class="swiper-slide competition-swiper__full-height">
                              <a
                                href={src}
                                data-pswp-width={width}
                                data-pswp-height={height}
                                data-pswp-item
                                target="_blank"
                                rel="noopener"
                                aria-label={`Открыть: ${alt}`}
                              >
                                <img
                                  src={src}
                                  alt={alt}
                                  width={width}
                                  height={height}
                                  loading={
                                    slideIndex === 0 && imageIndex === 0
                                      ? "eager"
                                      : "lazy"
                                  }
                                  decoding="async"
                                />
                              </a>
                            </div>
                          ),
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <a
                    href={images[0].src}
                    data-pswp-width={images[0].width}
                    data-pswp-height={images[0].height}
                    data-pswp-item
                    target="_blank"
                    rel="noopener"
                    aria-label={`Открыть: ${images[0].alt}`}
                  >
                    <img
                      src={images[0].src}
                      alt={images[0].alt}
                      width={images[0].width}
                      height={images[0].height}
                      loading={slideIndex === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>

      {
        hasNavigation && (
          <>
            <button
              class="swiper-nav prev"
              data-competition-main-prev
              type="button"
            >
              Предыдущая конкурсная работа
            </button>
            <button
              class="swiper-nav next"
              data-competition-main-next
              type="button"
            >
              Следующая конкурсная работа
            </button>
          </>
        )
      }

      {
        hasNestedNavigation && (
          <>
            <button
              class="swiper-nav small prev competition-swiper__nested-nav competition-swiper__nested-nav--prev"
              data-competition-nested-prev
              type="button"
              hidden
            >
              Предыдущее изображение работы
            </button>
            <button
              class="swiper-nav small next competition-swiper__nested-nav competition-swiper__nested-nav--next"
              data-competition-nested-next
              type="button"
              hidden
            >
              Следующее изображение работы
            </button>
          </>
        )
      }
    </div>

    <div
      class="competition-swiper__info"
      data-competition-swiper-info
      aria-live="polite"
      aria-atomic="true"
    >
      {
        slides.map(({ creator }, index) => (
          <div data-slide-info={index} hidden={index !== 0}>
            <DrawingInfo text={text} creator={creator} />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .competition-swiper {
    & .competition-swiper__content,
    & .competition-swiper__media {
      min-width: 0;
    }

    & .competition-swiper__content {
      max-width: 798px;
      margin-inline: auto;
    }

    & .competition-swiper__media {
      position: relative;
      padding-block: var(--space16);

      /* tablet */
      @media (width >= 768px) {
        padding-block: var(--space24);
      }
    }

    & .competition-swiper__main {
      width: 100%;
      min-width: 0;
      aspect-ratio: 1136 / 598;
      border: 1px solid rgba(165, 122, 240, 0.15);
      border-radius: 20px;
      background-color: var(--color-bg-primary-light);

      /* desktop */
      @media (width >= 960px) {
        aspect-ratio: 2090 / 1562;
        border-width: 0;
        border-radius: 48px;
        outline: 2px solid rgba(165, 122, 240, 0.15);
        outline-offset: -2px;
      }
    }

    & .competition-swiper__full-height {
      height: 100%;
    }

    & .competition-swiper__nested {
      position: relative;
      width: 100%;
    }

    & .swiper-slide a {
      display: block;
      width: 100%;
      height: 100%;

      &:focus-visible {
        outline: 3px solid var(--color-text-primary);
        outline-offset: -3px;
      }
    }

    & .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    & [data-competition-main-prev],
    & [data-competition-main-next] {
      position: absolute;
      z-index: 3;
      top: 50%;
      transform: translateY(-50%);

      &:focus-visible {
        outline: 3px solid var(--color-text-primary);
        outline-offset: 3px;
      }
    }

    & [data-competition-main-prev] {
      left: calc(var(--size) / -2);

      /* desktop */
      @media (width >= 960px) {
        left: 0;
        transform: translate(-50%);
      }
    }

    & [data-competition-main-next] {
      right: calc(var(--size) / -2);

      /* desktop */
      @media (width >= 960px) {
        right: 0;
        transform: translate(50%);
      }
    }

    & .competition-swiper__nested-nav {
      position: absolute;
      z-index: 2;
      left: 50%;
      transform: translateX(-50%) rotate(90deg);

      &[hidden] {
        display: none;
      }

      &:focus-visible {
        outline: 3px solid var(--color-text-primary);
        outline-offset: 3px;
      }
    }

    & .competition-swiper__nested-nav--prev {
      top: 0;
    }

    & .competition-swiper__nested-nav--next {
      bottom: 0;
    }

    & .competition-swiper__info {
      width: 100%;
      min-width: 0;
      margin-inline: auto;
    }

    /* desktop */
    @media (width >= 960px) {
      gap: var(--space12);
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import Swiper from "swiper";
  import { A11y, Navigation } from "swiper/modules";

  document
    .querySelectorAll<HTMLElement>("[data-competition-swiper]")
    .forEach((root) => {
      const mainElement = root.querySelector<HTMLElement>(
        "[data-competition-main]",
      );
      const previousButton = root.querySelector<HTMLButtonElement>(
        "[data-competition-main-prev]",
      );
      const nextButton = root.querySelector<HTMLButtonElement>(
        "[data-competition-main-next]",
      );
      const nestedPreviousButton = root.querySelector<HTMLButtonElement>(
        "[data-competition-nested-prev]",
      );
      const nestedNextButton = root.querySelector<HTMLButtonElement>(
        "[data-competition-nested-next]",
      );
      const infoItems = root.querySelectorAll<HTMLElement>("[data-slide-info]");
      const lightboxElement = root.querySelector<HTMLElement>(
        "[data-competition-lightbox]",
      );

      if (!mainElement || mainElement.dataset.initialized === "true") {
        return;
      }

      const mainSwiper = new Swiper(mainElement, {
        modules: [Navigation, A11y],
        slidesPerView: 1,
        speed: 500,
        loop: root.dataset.loop === "true",
        navigation: {
          prevEl: previousButton,
          nextEl: nextButton,
        },
        a11y: {
          prevSlideMessage: "Предыдущая конкурсная работа",
          nextSlideMessage: "Следующая конкурсная работа",
          firstSlideMessage: "Это первая конкурсная работа",
          lastSlideMessage: "Это последняя конкурсная работа",
        },
      });

      if (lightboxElement) {
        const lightbox = new PhotoSwipeLightbox({
          gallery: lightboxElement,
          children: "[data-pswp-item]",
          arrowPrevSVG: "",
          arrowNextSVG: "",
          pswpModule: () => import("photoswipe"),
        });

        lightbox.addFilter("uiElement", (element, data) => {
          if (data.name === "arrowPrev") {
            element.classList.add("swiper-nav", "prev");
          }

          if (data.name === "arrowNext") {
            element.classList.add("swiper-nav", "next");
          }

          return element;
        });

        lightbox.init();
      }

      const updateDrawingInfo = () => {
        infoItems.forEach((item, index) => {
          item.hidden = index !== mainSwiper.realIndex;
        });
      };

      const getActiveNestedSwiper = () => {
        const activeSlide = mainSwiper.slides[mainSwiper.activeIndex];
        const nestedElement = activeSlide?.querySelector<
          HTMLElement & { swiper?: Swiper }
        >("[data-competition-nested]");

        return nestedElement?.swiper;
      };

      const updateNestedNavigation = () => {
        const nestedSwiper = getActiveNestedSwiper();
        const hasActiveNestedSwiper = Boolean(nestedSwiper);

        if (nestedPreviousButton) {
          nestedPreviousButton.hidden = !hasActiveNestedSwiper;
          nestedPreviousButton.disabled = !nestedSwiper;
        }

        if (nestedNextButton) {
          nestedNextButton.hidden = !hasActiveNestedSwiper;
          nestedNextButton.disabled = !nestedSwiper;
        }
      };

      nestedPreviousButton?.addEventListener("click", () => {
        getActiveNestedSwiper()?.slidePrev();
      });
      nestedNextButton?.addEventListener("click", () => {
        getActiveNestedSwiper()?.slideNext();
      });

      mainSwiper.on("realIndexChange", () => {
        updateDrawingInfo();
        updateNestedNavigation();
      });

      root
        .querySelectorAll<HTMLElement>("[data-competition-nested]")
        .forEach((nestedElement) => {
          if (nestedElement.dataset.initialized === "true") {
            return;
          }

          const nestedSwiper = new Swiper(nestedElement, {
            modules: [A11y],
            direction: "vertical",
            slidesPerView: 1,
            speed: 500,
            loop: true,
            nested: true,
            a11y: {
              prevSlideMessage: "Предыдущее изображение работы",
              nextSlideMessage: "Следующее изображение работы",
              firstSlideMessage: "Это первое изображение работы",
              lastSlideMessage: "Это последнее изображение работы",
            },
          });

          nestedSwiper.on("slideChange", updateNestedNavigation);
          nestedElement.dataset.initialized = "true";
        });

      updateDrawingInfo();
      updateNestedNavigation();
      mainElement.dataset.initialized = "true";
    });
</script>
