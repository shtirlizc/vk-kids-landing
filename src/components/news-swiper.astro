---
interface SlideImage {
  src: string;
  width: number;
  height: number;
}

interface NewsSlide {
  category: string;
  title: string;
  image: SlideImage;
  imageAlt: string;
}

interface Props {
  slides: NewsSlide[];
}

const { slides } = Astro.props;
const hasNavigation = slides.length > 1;
---

<div
  class="news-slider"
  data-news-slider
  role="region"
  aria-label="Последние новости"
>
  <div class="news-slider__viewport">
    <div class="swiper news-slider__swiper" data-news-swiper>
      <div class="swiper-wrapper">
        {
          slides.map(({ category, title, image, imageAlt }, index) => (
            <article class="swiper-slide">
              <div class="news-card">
                <img
                  class="news-card__image"
                  src={image.src}
                  alt={imageAlt}
                  width={image.width}
                  height={image.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="news-card__category">{category}</span>
                <p class="news-card__title">{title}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  {
    hasNavigation && (
      <>
        <button
          class="swiper-nav prev news-slider__button news-slider__button--prev"
          data-news-prev
          type="button"
          aria-label="Предыдущая новость"
        >
          Предыдущая новость
        </button>
        <button
          class="swiper-nav next news-slider__button news-slider__button--next"
          data-news-next
          type="button"
          aria-label="Следующая новость"
        >
          Следующая новость
        </button>
      </>
    )
  }
</div>

<style>
  .news-slider {
    position: relative;
    flex: none;
    width: 100vw;

    & .news-slider__swiper {
      width: calc(100vw - 2 * var(--container-padding));
      margin-left: var(--container-padding);
      overflow: visible;

      /* fullhd */
      @media (width >= 1600px) {
        width: calc(var(--container) - 2 * var(--container-padding));
        margin-left: calc(
          (100vw - var(--container)) / 2 + var(--container-padding)
        );
      }

      & > .swiper-wrapper > .swiper-slide {
        /* tablet */
        @media (width >= 768px) {
          width: 365px;
        }
      }
    }

    & .news-card {
      aspect-ratio: 1;
      position: relative;
      border-radius: var(--border-radius20);
      overflow: hidden;
      padding: var(--space16);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;

      /* tablet */
      @media (width >= 768px) {
        aspect-ratio: 365 / 350;

        border-radius: var(--space32);
        padding: var(--space32);
      }

      &::after {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          rgba(47, 57, 117, 0.06) 12%,
          rgba(47, 57, 117, 0.22) 47%,
          rgba(35, 30, 91, 0.94) 100%
        );
        content: "";
        pointer-events: none;
      }
    }

    & .news-card__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 65%;
    }

    & .news-card__category {
      position: relative;
      z-index: 1;
      padding: 2px 8px 0;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      border-radius: 16px;
      background-color: #dffaff;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: -2%;
      height: 29px;
      line-height: 29px;

      /* tablet */
      @media (width >= 768px) {
        font-size: 16px;
      }
    }

    & .news-card__title {
      position: relative;
      color: var(--color-bg-main);
      font-size: 15px;
      font-weight: 500;
      line-height: 1.25em;
      z-index: 1;

      /* tablet */
      @media (width >= 768px) {
        font-size: 18px;
      }
    }

    & .news-slider__button {
      position: absolute;
      z-index: 3;
      top: 50%;
      display: none;
      transform: translateY(-50%);

      /* tablet */
      @media (width >= 768px) {
        display: flex;
      }

      &:focus-visible {
        outline: 3px solid var(--color-text-primary);
        outline-offset: 3px;
      }
    }

    & .news-slider__button--prev {
      left: var(--space12);

      /* fullhd */
      @media (width >= 1600px) {
        left: calc((100vw - var(--container)) / 2 + 12px);
      }
    }

    & .news-slider__button--next {
      right: var(--space12);

      /* fullhd */
      @media (width >= 1600px) {
        right: calc((100vw - var(--container)) / 2 + 6px);
      }
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { A11y, FreeMode, Navigation } from "swiper/modules";

  document
    .querySelectorAll<HTMLElement>("[data-news-slider]")
    .forEach((root) => {
      const swiperElement =
        root.querySelector<HTMLElement>("[data-news-swiper]");
      const previousButton =
        root.querySelector<HTMLButtonElement>("[data-news-prev]");
      const nextButton =
        root.querySelector<HTMLButtonElement>("[data-news-next]");

      if (!swiperElement || swiperElement.dataset.initialized === "true") {
        return;
      }

      new Swiper(swiperElement, {
        modules: [Navigation, A11y, FreeMode],
        slidesPerView: 1.05,
        spaceBetween: 10,
        speed: 500,
        rewind: true,
        navigation: {
          prevEl: previousButton,
          nextEl: nextButton,
        },
        breakpoints: {
          768: {
            spaceBetween: 20,
          },
          960: {
            freeMode: true,
            slidesPerView: "auto",
            spaceBetween: 20,
          },
        },
        a11y: {
          prevSlideMessage: "Предыдущая новость",
          nextSlideMessage: "Следующая новость",
          firstSlideMessage: "Это первая новость",
          lastSlideMessage: "Это последняя новость",
        },
      });

      swiperElement.dataset.initialized = "true";
    });
</script>
