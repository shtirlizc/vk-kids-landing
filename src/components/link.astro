---
interface Props {
  href?: string;
  view?: "primary" | "secondary";
  size?: "m" | "l";
  block?: boolean;
  isTargetBlank?: boolean;
}

const {
  href,
  view = "primary",
  size = "m",
  block = false,
  isTargetBlank = true,
} = Astro.props;
---

<a
  class:list={[
    "link",
    view === "primary" ? "primary" : "secondary",
    size === "m" ? "middle" : "large",
    block && "block",
  ]}
  href={href}
  target={isTargetBlank ? "_blank" : undefined}
>
  <slot />
</a>

<style>
  .link {
    font-family: var(--font-vk-condensed), sans-serif;
    font-weight: 500;
    font-size: 18px;
    text-transform: uppercase;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: var(--color-bg-main);
    padding: 2px 42px 0;
    border-radius: 16px;
    cursor: pointer;
    transition:
      color var(--transition),
      border var(--transition),
      background-color var(--transition);

    height: 54px;

    /* tablet */
    @media (width >= 768px) {
      border-radius: 24px;
      font-size: 24px;

      &.middle {
        height: 69px;
      }
      &.large {
        height: 72px;
      }
    }

    &.primary {
      border: 1px solid var(--color-primary);
      background-color: var(--color-primary);

      &:hover {
        color: var(--color-primary);
        background-color: transparent;
      }
    }
    &.secondary {
      border: 1px solid var(--color-secondary);
      background-color: var(--color-secondary);

      &:hover {
        color: var(--color-text-primary);
        border-color: var(--color-text-primary);
        background-color: transparent;
      }
    }

    &.block {
      width: 100%;
    }
  }
</style>
