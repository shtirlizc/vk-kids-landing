---
import Logos from "./logos.astro";
import Container from "./container.astro";

const nav = [
  {
    href: "services",
    label: "Возможности",
  },
  {
    href: "channels",
    label: "Каналы",
  },
  {
    href: "faq",
    label: "FAQ",
  },
];
---

<header class="header">
  <Container>
    <div class="header__content">
      <Logos />

      <nav>
        <ul>
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={`#${href}`} class="badge light">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    height: var(--header);
    z-index: 1;

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;

      nav {
        ul {
          list-style: none;
          padding: 0;
          display: flex;
          align-items: center;
          gap: var(--space24);
        }
      }
    }
  }
</style>
