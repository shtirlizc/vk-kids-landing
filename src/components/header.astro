---
import Logos from "./logos.astro";
import Container from "./container.astro";
import CloseIcon from "../assets/images/close-icon.svg";

const nav = [
  {
    href: "services",
    label: "Возможности",
  },
  {
    href: "channels",
    label: "Каналы",
  },
  {
    href: "faq",
    label: "FAQ",
  },
];
---

<header class="header">
  <Container>
    <div class="header__content">
      <div class="header__logo">
        <Logos />
      </div>

      <button class="header__burger">
        <CloseIcon />
      </button>

      <nav>
        <ul>
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={`#${href}`} class="badge light">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    height: var(--header);
    z-index: 2;
    background-color: var(--color-bg-primary);

    @supports ((animation-timeline: scroll()) and (animation-range: 0 400px)) {
      background-color: transparent;
      animation: header-bg 1s linear;
      animation-timeline: scroll(root block);
      animation-range: 0 400px;
      animation-fill-mode: both;
    }

    & .header__logo {
      z-index: 1;
    }

    & .header__burger {
      border: none;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: var(--color-bg-main);
      z-index: 1;

      /* desktop */
      @media (width >= 960px) {
        display: none;
      }
    }

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;

      nav {
        position: fixed;
        top: 0;
        left: 0;
        padding-top: var(--header);
        width: 100%;
        height: calc(100dvh - var(--header));
        background: linear-gradient(
          180deg,
          #e5d2ff 0%,
          #dec7ff 25%,
          rgba(222, 199, 255, 0.01) 70%,
          rgba(222, 199, 255, 0.01) 100%
        );
        backdrop-filter: blur(8px);

        /* desktop */
        @media (width >= 960px) {
          /* media query rules */
        }

        ul {
          list-style: none;
          display: grid;
          gap: 10px;
          padding: var(--space) var(--space24);

          /* desktop */
          @media (width >= 960px) {
            display: flex;
            align-items: center;
            gap: var(--space24);
            padding: 0;
          }

          a {
            /* not desktop */
            @media (width < 960px) {
              width: 100%;
              height: 54px;
              line-height: 54px;
              border-radius: 27px;
              font-size: 18px;
            }
          }
        }
      }
    }
  }

  @keyframes header-bg {
    from {
      background-color: transparent;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0);
    }

    to {
      background-color: var(--color-bg-primary);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
    }
  }
</style>
