---
import Logos from "./logos.astro";
import Container from "./container.astro";

const nav = [
  {
    href: "services",
    label: "Возможности",
  },
  {
    href: "channels",
    label: "Каналы",
  },
  {
    href: "faq",
    label: "FAQ",
  },
];
---

<header class="header">
  <Container>
    <div class="header__content">
      <Logos />

      <nav>
        <ul>
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={`#${href}`} class="badge light">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    height: var(--header);
    z-index: 2;
    background-color: var(--color-bg-primary);

    @supports ((animation-timeline: scroll()) and (animation-range: 0 400px)) {
      background-color: transparent;
      animation: header-bg 1s linear;
      animation-timeline: scroll(root block);
      animation-range: 0 400px;
      animation-fill-mode: both;
    }

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;

      nav {
        ul {
          list-style: none;
          padding: 0;
          display: flex;
          align-items: center;
          gap: var(--space24);
        }
      }
    }
  }

  @keyframes header-bg {
    from {
      background-color: transparent;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0);
    }

    to {
      background-color: var(--color-bg-primary);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
    }
  }
</style>
