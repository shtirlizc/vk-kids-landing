---
import Logos from "./logos.astro";
import Container from "./container.astro";
import OpenIcon from "../assets/images/open-icon.svg";
import CloseIcon from "../assets/images/close-icon.svg";
import { nav } from "../nav.ts";
---

<header class="header">
  <Container>
    <div class="header__content">
      <div class="header__logo">
        <Logos />
      </div>

      <button
        class="header__burger"
        type="button"
        aria-label="Открыть меню"
        aria-expanded="false"
      >
        <OpenIcon class="header__burger-icon" />
        <CloseIcon class="header__burger-morph-target" aria-hidden="true" />
      </button>

      <nav id="page-nav" aria-hidden="true">
        <ul>
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={`#${href}`} class="badge light">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--color-bg-primary);

    @supports ((animation-timeline: scroll()) and (animation-range: 0 400px)) {
      background-color: transparent;
      animation: header-bg 1s linear;
      animation-timeline: scroll(root block);
      animation-range: 0 400px;
      animation-fill-mode: both;
    }

    & .header__logo {
      z-index: 1;
    }

    & .header__burger {
      border: none;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: var(--color-bg-main);
      z-index: 1;

      & .header__burger-morph-target {
        position: absolute;
        width: 0;
        height: 0;
        visibility: hidden;
      }

      /* desktop */
      @media (width >= 960px) {
        display: none;
      }
    }

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: var(--header);

      @supports (
        (animation-timeline: scroll()) and (animation-range: 0 400px)
      ) {
        animation: header-height 1s linear;
        animation-timeline: scroll(root block);
        animation-range: 0 400px;
        animation-fill-mode: both;
      }

      nav {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        padding-top: var(--header);
        width: 100%;
        height: 100dvh;
        background: linear-gradient(
          180deg,
          #e5d2ff 0%,
          #dec7ff 25%,
          rgba(222, 199, 255, 0.01) 70%,
          rgba(222, 199, 255, 0.01) 100%
        );
        backdrop-filter: blur(8px);

        /* desktop */
        @media (width >= 960px) {
          display: block;
          position: static;
          padding-top: 0;
          width: auto;
          height: auto;
          background: none;
          backdrop-filter: none;
        }

        ul {
          list-style: none;
          display: grid;
          gap: 10px;
          padding: var(--space) var(--space24);

          /* desktop */
          @media (width >= 960px) {
            display: flex;
            align-items: center;
            gap: var(--space24);
            padding: 0;
          }

          a {
            /* not desktop */
            @media (width < 960px) {
              width: 100%;
              height: 54px;
              line-height: 54px;
              border-radius: 27px;
              font-size: 18px;
            }
          }
        }
      }
    }
  }

  @keyframes header-bg {
    from {
      background-color: transparent;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0);
    }

    to {
      background-color: var(--color-bg-primary);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
    }
  }

  @keyframes header-height {
    from {
      height: var(--header);
    }

    to {
      height: 80px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";

  gsap.registerPlugin(MorphSVGPlugin);

  document.querySelectorAll(".header__burger").forEach((button) => {
    const iconPath = button.querySelector(".header__burger-icon path");
    const targetPath = button.querySelector(
      ".header__burger-morph-target path",
    );
    const menu = button.parentElement?.querySelector("nav");
    const menuItems = menu?.querySelectorAll("li");

    if (
      !(iconPath instanceof SVGPathElement) ||
      !(targetPath instanceof SVGPathElement) ||
      !menu ||
      !menuItems?.length
    ) {
      return;
    }

    const iconMorph = gsap.timeline({ paused: true }).to(iconPath, {
      duration: 0.3,
      ease: "sine.inOut",
      morphSVG: targetPath,
    });

    const menuAnimation = gsap
      .timeline({
        paused: true,
        onReverseComplete: () => {
          gsap.set(menu, { display: "none" });
        },
      })
      .set(menu, { display: "block", autoAlpha: 0 })
      .set(menuItems, { autoAlpha: 0, y: 12 })
      .to(menu, { autoAlpha: 1, duration: 0.4, ease: "sine.out" })
      .to(
        menuItems,
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.3,
          ease: "sine.out",
          stagger: 0.07,
        },
        "-=0.1",
      );

    let isMenuOpen = false;
    const desktopQuery = window.matchMedia("(min-width: 960px)");

    const resetMenu = () => {
      isMenuOpen = false;
      iconMorph.pause(0);
      menuAnimation.pause(0);
      gsap.set([menu, ...menuItems], { clearProps: "all" });
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Открыть меню");
      menu.setAttribute("aria-hidden", String(!desktopQuery.matches));
    };

    if (desktopQuery.matches) resetMenu();

    desktopQuery.addEventListener("change", resetMenu);

    const closeMenu = () => {
      if (!isMenuOpen) return;

      isMenuOpen = false;
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Открыть меню");
      menu.setAttribute("aria-hidden", "true");
      iconMorph.reverse();
      menuAnimation.reverse();
    };

    button.addEventListener("click", () => {
      if (isMenuOpen) {
        closeMenu();
      } else {
        isMenuOpen = true;
        button.setAttribute("aria-expanded", "true");
        button.setAttribute("aria-label", "Закрыть меню");
        menu.setAttribute("aria-hidden", "false");
        iconMorph.play();
        menuAnimation.play();
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (!desktopQuery.matches) closeMenu();
      });
    });
  });
</script>
