---
import Logos from "./logos.astro";
import Container from "./container.astro";
---

<header class="header">
  <Container>
    <div class="header__content">
      <Logos />

      <nav>
        <ul>
          <li>
            <a href="#services" class="badge">Возможности</a>
          </li>
          <li>
            <a href="#channels" class="badge">Каналы</a>
          </li>
          <li>
            <a href="#faq" class="badge">FAQ</a>
          </li>
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    height: var(--header);

    & .header__content {
      display: flex;
      justify-content: space-between;
      align-items: center;

      nav {
        ul {
          list-style: none;
          padding: 0;
          display: flex;
          align-items: center;
          gap: var(--space24);
        }
      }
    }
  }
</style>
