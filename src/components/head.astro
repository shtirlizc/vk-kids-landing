---
import "../styles/_main.css";

import { Font } from "astro:assets";

const faviconPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon/`;
const pageUrl = "https://shtirlizc.github.io/vk-kids-landing/";
const pageTitle = "Семья и дети | Детский конкурс";
const pageDescription = "Детский конкурс для всей семьи от VK.";
const openGraphImageUrl =
  "https://shtirlizc.github.io/vk-kids-landing/OpenGraph.jpg";
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-vk-display" />
  <Font cssVariable="--font-vk-text" />
  <Font cssVariable="--font-vk-condensed" />

  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href={`${faviconPath}favicon-32x32.png`}
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href={`${faviconPath}favicon-16x16.png`}
  />
  <link rel="icon" href={`${faviconPath}favicon.ico`} sizes="any" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href={`${faviconPath}apple-touch-icon.png`}
  />
  <link rel="manifest" href={`${faviconPath}site.webmanifest`} />
  <link rel="canonical" href={pageUrl} />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#dec7ff" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:site_name" content="Семья и дети" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:image" content={openGraphImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={openGraphImageUrl} />
  <meta name="twitter:image:alt" content={pageTitle} />
  <title>{pageTitle}</title>

  <!-- Top.Mail.Ru counter -->
  <script is:inline>
    var _tmr = window._tmr || (window._tmr = []);
    _tmr.push({ id: "2183087", type: "pageView", start: new Date().getTime() });
    (function (d, w, id) {
      if (d.getElementById(id)) return;
      var ts = d.createElement("script");
      ts.type = "text/javascript";
      ts.async = true;
      ts.id = id;
      ts.src = "https://top-fwz1.mail.ru/js/code.js";
      var f = function () {
        var s = d.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(ts, s);
      };
      if (w.opera == "[object Opera]") {
        d.addEventListener("DOMContentLoaded", f, false);
      } else {
        f();
      }
    })(document, window, "tmr-code");
  </script>
  <!-- /Top.Mail.Ru counter -->
</head>
