---
import rattle from "./../assets/images/hero/rattle.webp";
import Arrow from "./../assets/images/arrow.svg";
import rattleMobile from "./../assets/images/hero/rattle-mobile.webp";
import { CategoryId } from "./services/data.ts";

const badges: { label: string; tabId: CategoryId }[] = [
  { label: "помощь при рождении ребёнка", tabId: CategoryId.Pregnancy },
  { label: "медицина для близких", tabId: CategoryId.Health },
  { label: "детское образование", tabId: CategoryId.Parenting },
  {
    label: "мероприятия и идеи для совместного досуга",
    tabId: CategoryId.Events,
  },
];
---

<section class="hero">
  <div class="hero__content">
    <div class="hero__subtitle">
      <p>о семье</p>
      <p>заботимся</p>
    </div>
    <picture>
      <source
        media="(width >= 960px)"
        srcset={rattle.src}
        width={rattle.width}
        height={rattle.height}
      />
      <img
        src={rattleMobile.src}
        width={rattleMobile.width}
        height={rattleMobile.height}
        alt="Семья и дети"
      />
    </picture>
  </div>
  <div class="hero__links">
    <div></div>
    <nav>
      <ul>
        {
          badges.map(({ label, tabId }) => (
            <li>
              <button type="button" data-tab-id={tabId} class="badge">
                {label}
              </button>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <a
    class="hero__arrow"
    href="#competition"
    aria-label="Перейти к следующему разделу"
  >
    <Arrow />
  </a>
</section>

<style>
  .hero {
    margin-top: calc(var(--header) * -1);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-image: var(--bg-gradient);
    border-radius: 0 0 20px 20px;

    /* desktop */
    @media (width >= 960px) {
      border-radius: 0 0 48px 48px;
      background-image:
        url(./../assets/images/hero/horse.webp),
        url(./../assets/images/hero/star.webp), var(--bg-gradient);
      background-repeat: no-repeat;
      background-position:
        left bottom,
        right bottom,
        center;
      background-size:
        342px auto,
        462px auto,
        cover;
      padding-bottom: 155px;
    }

    & .hero__content {
      position: relative;
      align-self: flex-end;

      /* desktop */
      @media (width >= 960px) {
        align-self: center;
      }
    }

    & .hero__subtitle {
      font-family: var(--font-vk-condensed), sans-serif;
      font-size: 28px;
      font-weight: 500;
      position: absolute;
      display: flex;
      justify-content: space-between;
      flex-direction: column;
      bottom: 60%;
      left: -13px;
      width: 185px;

      /* tablet */
      @media (width >= 768px) {
        bottom: 52.2%;
        left: 0;
        width: 300px;
        font-size: 35px;
      }

      /* desktop */
      @media (width >= 960px) {
        bottom: 52.2%;
        left: 0;
        width: 290px;
        font-size: 35px;
      }

      /* widescreen */
      @media (width >= 1200px) {
        width: 344px;
      }

      p:first-child {
        text-align: right;
      }
    }

    & picture,
    & img {
      width: 100%;
      max-width: 336px;
      height: auto;

      /* desktop */
      @media (width >= 960px) {
        max-width: calc(100vw - 40px);
      }

      /* widescreen */
      @media (width >= 1300px) {
        max-width: 1250px;
      }
    }

    & .hero__links {
      margin: 19px 0 82px;

      /* desktop */
      @media (width >= 960px) {
        display: grid;
        grid-template-columns: 1fr 4fr 1fr;
        margin-top: -34px;
        margin-bottom: var(--space32);
      }

      /* widescreen */
      @media (width >= 1200px) {
        grid-template-columns: 1fr 2fr 1fr;
      }

      nav {
        display: flex;
        justify-content: center;
        padding: var(--container-padding);

        ul {
          list-style: none;
          padding: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: var(--space8);
        }
      }
    }

    & .hero__arrow {
      position: absolute;
      font-size: 0;
      padding: var(--space16);
      bottom: var(--space12);
      left: 50%;
      transform: translateX(-50%);
      color: var(--color-bg-main);
      transition: color var(--transition);

      &:hover {
        color: var(--color-primary);
      }

      @media (width >= 768px) {
        bottom: var(--space16);
      }
    }
  }
</style>

<script>
  import { setCategoryInUrl } from "./services/category-url.ts";

  document
    .querySelectorAll<HTMLButtonElement>(".hero__links .badge")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const tabId = button.dataset.tabId;

        if (!tabId) return;

        setCategoryInUrl(tabId);
        document.getElementById("services")?.scrollIntoView();
      });
    });
</script>
