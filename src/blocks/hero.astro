---
import rattle from "./../assets/images/hero/rattle.webp";
import Arrow from "./../assets/images/arrow.svg";
import rattleMobile from "./../assets/images/hero/rattle-mobile.webp";
import { CategoryId } from "./services/data.ts";
import Grid from "../components/grid.astro";

const badges: { label: string; tabId: CategoryId }[] = [
  { label: "помощь при рождении ребёнка", tabId: CategoryId.Pregnancy },
  { label: "медицина для близких", tabId: CategoryId.Health },
  { label: "детское образование", tabId: CategoryId.Parenting },
  {
    label: "мероприятия и идеи для совместного досуга",
    tabId: CategoryId.Kids,
  },
];
---

<section class="hero">
  <div class="hero__content">
    <div class="hero__subtitle">
      <p>о семье</p>
      <p>заботимся</p>
    </div>
    <picture>
      <source
        media="(width >= 960px)"
        srcset={rattle.src}
        width={rattle.width}
        height={rattle.height}
      />
      <img
        src={rattleMobile.src}
        width={rattleMobile.width}
        height={rattleMobile.height}
        alt="Семья и дети"
      />
    </picture>
  </div>
  <div class="hero__links">
    <Grid cols={[2, 4, 2]} offset={1}>
      <nav>
        <ul>
          {
            badges.map(({ label, tabId }) => (
              <li>
                <button type="button" data-tab-id={tabId} class="badge">
                  {label}
                </button>
              </li>
            ))
          }
        </ul>
      </nav>
    </Grid>
  </div>
  <a
    class="hero__arrow"
    href="#competition"
    aria-label="Перейти к следующему разделу"
  >
    <Arrow />
  </a>
</section>

<style>
  .hero {
    margin: 100px 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(var(--header) * -1);
    background-image: var(--bg-gradient);
    border-radius: 0 0 32px 32px;

    /* tablet */
    @media (width >= 768px) {
      border-radius: 0 0 48px 48px;
      background-image:
        url(./../assets/images/hero/horse.webp),
        url(./../assets/images/hero/star.webp), var(--bg-gradient);
      background-repeat: no-repeat;
      background-position:
        left bottom,
        right bottom,
        center;
      background-size:
        342px auto,
        462px auto,
        cover;
      padding-bottom: 187px;
    }

    & .hero__content {
      position: relative;
      align-self: flex-end;

      /* tablet */
      @media (width >= 768px) {
        align-self: center;
      }
    }

    & .hero__subtitle {
      font-family: var(--font-vk-condensed), sans-serif;
      font-size: 28px;
      font-weight: 500;
      position: absolute;
      display: flex;
      justify-content: space-between;
      flex-direction: column;
      bottom: 60%;
      left: 7%;
      width: 160px;

      /* tablet */
      @media (width >= 768px) {
        bottom: 50%;
        left: 0;
        width: 350px;
        font-size: 35px;
      }

      p:first-child {
        text-align: right;
      }
    }

    & picture,
    & img {
      width: 100%;
      max-width: 336px;
      height: auto;

      /* tablet */
      @media (width >= 768px) {
        max-width: 1250px;
      }
    }

    & .hero__links {
      margin: 15px 0 82px;

      nav {
        display: flex;
        justify-content: center;

        ul {
          list-style: none;
          padding: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: var(--space8);
        }
      }
    }

    & .hero__arrow {
      position: absolute;
      bottom: var(--space16);
      left: 50%;
      transform: translateX(-50%);
      color: var(--color-bg-main);
      padding: 0;
      border: 0;
      font: inherit;
      background: none;
      cursor: pointer;

      &:hover {
        color: var(--color-bg-primary-light);
      }

      @media (width >= 768px) {
        bottom: var(--space32);
      }
    }
  }
</style>

<script>
  import { setCategoryInUrl } from "./services/category-url.ts";

  document
    .querySelectorAll<HTMLButtonElement>(".hero__links .badge")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const tabId = button.dataset.tabId;

        if (!tabId) return;

        setCategoryInUrl(tabId);
        document.getElementById("services")?.scrollIntoView();
      });
    });
</script>
