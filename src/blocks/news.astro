---
import Container from "../components/container.astro";
import Title from "../components/title.astro";
import NewsSwiper from "../components/news-swiper.astro";
import newsImage1 from "../assets/images/news/news-1.webp";
import newsImage2 from "../assets/images/news/news-2.webp";
import newsImage3 from "../assets/images/news/news-3.webp";
import newsImage4 from "../assets/images/news/news-4.webp";

const news = [
  {
    category: "Сферум",
    title:
      "«Стесняюсь спросить» — новый проект о\u00A0взрослении для\u00A0девочек-подростков",
    image: newsImage1,
    imageAlt: "",
  },
  {
    category: "Код заботы",
    title:
      "К\u00A01\u00A0Сентября собрали всё, что\u00A0поможет подготовиться к\u00A0учебному году быстрее и\u00A0выгоднее",
    image: newsImage2,
    imageAlt: "",
  },
  {
    category: "Код заботы",
    title:
      "Запустили программу проверки мужского здоровья для\u00A0подготовки к\u00A0отцовству",
    image: newsImage3,
    imageAlt: "",
  },
  {
    category: "VK Музыка",
    title:
      "«Почему листья зелёные?» и\u00A0«Кто\u00A0живёт в\u00A0лесу?» Ответы на\u00A0сотни детских вопросов — в\u00A0аудиокнигах от\u00A0VK\u00A0Музыки и\u00A0НЭН",
    image: newsImage4,
    imageAlt: "",
  },
  {
    category: "VK Видео",
    title:
      "В\u00A0детском разделе VK Видео эксклюзивно запустили новый проект «Спокойной ночи, малыши! Ждут друзей» — современное переосмысление легендарной передачи.",
    image: newsImage2,
    imageAlt: "",
  },
];
---

<section class="news">
  <Container>
    <Title>последние новости</Title>
  </Container>

  <div class="news__content">
    <NewsSwiper slides={news} />
  </div>
</section>

<style>
  .news {
    overflow: hidden;

    & .news__content {
      margin-top: var(--space24);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space48);
      }
    }
  }
</style>
