---
import Container from "../components/container.astro";
import Title from "../components/title.astro";
import NewsSwiper from "../components/news-swiper.astro";
import newsImage1 from "../assets/images/news/news-1.webp";
import newsImage2 from "../assets/images/news/news-2.webp";
import newsImage3 from "../assets/images/news/news-3.webp";
import newsImage4 from "../assets/images/news/news-4.webp";
import newsImage5 from "../assets/images/news/news-5.webp";

const news = [
  {
    href: "https://max.ru/girls_ask_bot?start=pr",
    category: "Сферум",
    title:
      "«Стесняюсь спросить» —новый проект о взрослении для девочек-подростков",
    image: newsImage1,
    imageAlt: "",
  },
  {
    href: "https://home.vk.team/blog/entry/-k-uchebnomu-godu-spetsialnyie/",
    category: "Код заботы",
    title:
      "К 1 Сентября собрали всё, что поможет подготовиться к учебному году быстрее и выгоднее",
    image: newsImage2,
    imageAlt: "",
  },
  {
    href: "https://home.vk.team/blog/entry/reproduktivnyij-chekap-dlya-mu/",
    category: "Код заботы",
    title:
      "Запустили программу проверки мужского здоровья для подготовки к отцовству",
    image: newsImage3,
    imageAlt: "",
  },
  {
    href: "https://home.vk.team/blog/entry/pooschryaem-lyuboznatelnost-po/",
    category: "VK Музыка",
    title:
      "«Почему листья зелёные?» и «Кто живёт в лесу?» Ответы на сотни детских вопросов — в аудиокнигах от VK Музыки и НЭН",
    image: newsImage4,
    imageAlt: "",
  },
  {
    href: "https://vkvideo.ru/@spokoinoinochimalyshi",
    category: "VK Видео",
    title:
      "Запустили проект «Спокойной ночи, малыши! Ждут друзей» — современное переосмысление легендарной передачи",
    image: newsImage5,
    imageAlt: "",
  },
];
---

<section class="news">
  <Container>
    <Title>последние новости</Title>
  </Container>

  <div class="news__content">
    <NewsSwiper slides={news} />
  </div>
</section>

<style>
  .news {
    overflow: hidden;

    & .news__content {
      margin-top: var(--space24);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space48);
      }
    }
  }
</style>
