---
import Title from "../../components/title.astro";
import Container from "../../components/container.astro";
import Grid from "../../components/grid.astro";

const faq: { head: string; body?: string }[] = [
  {
    head: "Какие документы нужны при вступлении в\u00A0брак?",
    body: `
      <p>Если&nbsp;вы&nbsp;вступили в&nbsp;брак, передайте в&nbsp;отдел кадров свидетельство о&nbsp;браке&nbsp;— лично или&nbsp;в&nbsp;электронном виде. При&nbsp;смене фамилии дополнительно понадобятся СНИЛС, реквизиты на&nbsp;новую фамилию и&nbsp;заявление в&nbsp;отделе кадров.</p>
      <p>Если&nbsp;у&nbsp;вас родился ребёнок, предоставьте в&nbsp;отдел кадров свидетельство о&nbsp;рождении и&nbsp;напишите заявление на&nbsp;получение материальной помощи. С&nbsp;процессом поможет ваш&nbsp;HR-бизнес-партнёр.</p>
    `,
  },
  {
    head: "Что стоит сделать, если у\u00A0меня родился ребёнок?",
    body: `
      <p>Нужно предоставить свидетельство о&nbsp;рождении в&nbsp;отдел кадров и&nbsp;написать заявление на&nbsp;получение материальной помощи.</p>
      <ol>
        <li>Зайдите в&nbsp;систему по&nbsp;ссылке: <a href="https://vkdoc.mail.ru" target="_blank">vkdoc.mail.ru</a></li>
        <li>Нажмите кнопку «Создать заявку» в&nbsp;правом верхнем углу и&nbsp;выберите в&nbsp;открывшемся окне «Заявление на&nbsp;изменение персональных данных сотрудника»</li>
        <li>На&nbsp;открывшейся странице в&nbsp;строке «Причина изменения связана с&nbsp;» выберите «рождением ребёнка/детей». Приложите скан свидетельства о&nbsp;рождении и&nbsp;отправьте заявку. А&nbsp;если остаются вопросы, напишите в&nbsp;<a href="https://home.vk.team/structure/#unit637" target="_blank">отдел кадров</a> или&nbsp;своему HRBP</li>
      </ol>
    `,
  },
  {
    head: "Не нашли нужную информацию?",
    body: `
      <p>
        Напишите&nbsp;в <a
          href="https://u.internal.myteam.mail.ru/profile/support_bot"
          target="_blank">единый чат поддержки</a
        >&nbsp;с&nbsp;умным помощником Василисой или&nbsp;своему HRBP.
      </p>
    `,
  },
];
---

<section id="faq" class="faq">
  <Container>
    <Title>Ответы<br />на&nbsp;вопросы</Title>

    <Grid cols={[2, 4, 2]} offset={1}>
      <div class="faq_list">
        {
          faq.map(({ head, body }) => (
            <div class="faq__item">
              <div class="faq__head">
                <h3>{head}</h3>
                <div class="faq__icon" />
              </div>
              <div class="faq__body">
                <div class="faq__body-content text-content">
                  <Fragment set:html={body} />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Grid>
  </Container>
</section>

<style>
  .faq {
    & .faq_list {
      margin-top: var(--space28);
      display: grid;
      gap: var(--space8);

      /* desktop */
      @media (width >= 960px) {
        margin-top: 50px;
        gap: 6px;
      }

      .faq__item {
        background-color: var(--color-bg-main);
        border-radius: 24px;
      }

      .faq__head {
        display: grid;
        grid-template-columns: 1fr var(--space32);
        align-items: center;
        padding: 22px var(--space24) 20px;
        border-radius: 24px;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition:
          background-color var(--transition),
          padding var(--transition),
          margin var(--transition);

        /* desktop */
        @media (width >= 960px) {
          padding: 22px var(--space40) 20px;
        }

        &:hover {
          background-color: var(--color-bg-secondary);
        }

        h3 {
          font-weight: 600;
          font-size: 18px;
          line-height: 1.3em;
        }

        &.opened {
          padding-bottom: var(--space16);

          &:hover {
            margin-bottom: var(--space12);
          }

          .faq__icon::after {
            transform: rotate(-90deg);
          }
        }
      }

      .faq__icon {
        position: relative;

        &::before,
        &::after {
          content: "";
          position: absolute;
          background-color: var(--color-text-primary);
        }

        &::before {
          width: 10px;
          height: 2px;
          right: 0;
          top: calc(50% - 1px);
        }

        &::after {
          width: 2px;
          height: 10px;
          right: 4px;
          top: calc(50% - 5px);
          transition: transform var(--transition-long);
        }
      }

      .faq__body {
        height: 0;
        overflow: hidden;
        display: none;
      }

      .faq__body-content {
        padding: 0 var(--space24) var(--space24);

        /* desktop */
        @media (width >= 960px) {
          padding: 0 var(--space40) var(--space24);
        }
      }
    }
  }
</style>

<script>
  import gsap from "gsap";

  document.querySelectorAll<HTMLElement>(".faq__item").forEach((faqItem) => {
    const head = faqItem.querySelector<HTMLElement>(".faq__head");
    const body = faqItem.querySelector<HTMLElement>(".faq__body");

    if (!head || !body) {
      return;
    }

    head.addEventListener("click", () => {
      const isOpened = head.classList.toggle("opened");

      gsap.killTweensOf(body);

      if (isOpened) {
        gsap.set(body, { display: "block" });
        gsap.to(body, {
          height: "auto",
          duration: 0.5,
          ease: "power2.inOut",
        });
        return;
      }

      gsap.to(body, {
        height: 0,
        duration: 0.5,
        ease: "power2.inOut",
        onComplete: () => {
          if (!head.classList.contains("opened")) {
            gsap.set(body, { display: "none" });
          }
        },
      });
    });
  });
</script>
