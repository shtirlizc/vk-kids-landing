import CompetitionCompetitionSwiper from "../components/competition-swiper.astro";
import Container from "../components/container.astro";
import Title from "../components/title.astro";
import Description from "../components/description.astro";
import Link from "../components/link.astro";
import Grid from "../components/grid.astro";

const drawingInfoText =
  "Выберите работы, которые понравились больше всего — лучшие станут основной для новых детских карточек";

interface Creator {
  contactName: string;
  artistFirstName: string;
  contactHref?: string;
}

interface ImportedImage {
  src: string;
  width: number;
  height: number;
}

const imageModules = import.meta.glob<{ default: ImportedImage }>(
  "../assets/images/competition/*.webp",
  { eager: true },
);

const getImage = (filename: string) => {
  const path = `../assets/images/competition/${filename}`;
  const image = imageModules[path]?.default;

  if (!image) {
    throw new Error(`Competition image not found: ${filename}`);
  }

  return image;
};

