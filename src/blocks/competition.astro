const groupedSlideImages: Record<number, string[]> = {
  10: ["10.webp", "10.1.webp"],
  13: ["13.webp", "13.1.webp", "13.2.webp"],
  37: ["37.webp", "37.1.webp"],
  38: ["38.webp", "38.1.webp", "38.2.webp"],
};

const slides = Array.from({ length: 44 }, (_, index) => index + 1)
  .filter((slideNumber) => slideNumber !== 11 && slideNumber !== 12)
  .map((slideNumber) => {
    const imageNames = groupedSlideImages[slideNumber] ?? [
      `${slideNumber}.webp`,
    ];

    return {
      images: imageNames.map((filename, imageIndex) => {
        const image = getImage(filename);
        const position =
          imageNames.length > 1
            ? `, изображение ${imageIndex + 1} из ${imageNames.length}`
            : "";

        return {
          src: image.src,
          width: image.width,
          height: image.height,
          alt: `Конкурсная работа №${slideNumber}${position}`,
        };
      }),
      creator: creatorBySlide[slideNumber],
    };
  });
---

<section id="competition" class="competition">
  <Container>
    <div class="competition-content">
      <Grid cols={[2, 4, 2]} offset={1}>
        <div class="competition-header">
          <Title>детский конкурс</Title>
          <Description>
            Дети сотрудников VK придумали свои варианты дизайна карточки «Код
            заботы»
          </Description>
        </div>
      </Grid>

      <div class="competition-body">
        <CompetitionCompetitionSwiper slides={slides} text={drawingInfoText} />

        <div class="competition-foot">
          <Grid cols={[3, 2, 3]} offset={1}>
            <Link href="https://app.pthwy.ru/siz0X" isTargetBlank block>
              Перейти к голосованию
            </Link>
          </Grid>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .competition {
    margin: 82px 0;

    .competition-header {
      display: grid;
      gap: var(--space24);
    }

    & .competition-foot {
      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space24);
      }
    }
  }
</style>
