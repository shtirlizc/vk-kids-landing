---
import CompetitionSwiper from "../components/swiper.astro";
import Container from "../components/container.astro";
import competitionImage1 from "../assets/images/competition/competition-1.png";
import competitionImage2 from "../assets/images/competition/competition-2.jpg";
import competitionImage3 from "../assets/images/competition/competition-3.jpg";
import Title from "../components/title.astro";
import Description from "../components/description.astro";
import Link from "../components/link.astro";

const drawingInfoText =
  "Выберите работы, которые понравились больше всего — лучшие станут основной для новых детских карточек";

const slides = [
  {
    src: competitionImage1.src,
    alt: "Детский рисунок с животными, воздушными шарами и сердцами",
    creator: {
      contactName: "Валерия Мирошниченко",
      artistFirstName: "Мирошниченко Валентина, 7 лет",
      contactHref: "https://home.vk.team/users/va.miroshnichenko/",
    },
  },
  {
    src: competitionImage2.src,
    alt: "Работа участника конкурса",
    creator: {
      contactName: "Анна Кузнецова",
      artistFirstName: "Кузнецов Михаил, 8 лет",
    },
  },
  {
    src: competitionImage3.src,
    alt: "Работа участника конкурса",
    creator: {
      contactName: "Дмитрий Соколов",
      artistFirstName: "Соколова София, 6 лет",
    },
  },
];
---

<section id="competition" class="competition">
  <Container>
    <div class="competition-content">
      <div class="competition-header">
        <Title>детский конкурс</Title>
        <Description
          >Дети сотрудников VK придумали свои варианты дизайна карточки «Код
          заботы»</Description
        >
      </div>
      <div class="competition-body">
        <CompetitionSwiper slides={slides} text={drawingInfoText} />
        <p>
          <Link href="https://app.pthwy.ru/siz0X" isTargetBlank>
            Перейти к голосованию
          </Link>
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .competition {
    padding-block: 56px;

    /* tablet */
    @media (width >= 768px) {
      padding-block: 120px;
    }

    & .competition-content,
    & .competition-body,
    & .competition-header {
      display: flex;
      flex-direction: column;
    }

    & .competition-content {
      gap: var(--space28);

      @media (width >= 768px) {
        gap: var(--space36);
      }
    }

    & .competition-header,
    & .competition-body {
      gap: var(--space20);

      @media (width >= 768px) {
        gap: var(--space24);
      }
    }

    & .competition-body > p {
      text-align: center;
    }
  }
</style>
