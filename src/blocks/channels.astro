---
import { Image } from "astro:assets";
import Title from "../components/title.astro";
import Description from "../components/description.astro";

import channelImg1 from "../assets/images/channels/channel-1.webp";
import channelImg2 from "../assets/images/channels/channel-2.webp";
import channelImg3 from "../assets/images/channels/channel-3.webp";
import channelImg4 from "../assets/images/channels/channel-4.webp";
import braceletDesktopLeft from "../assets/images/channels/bracelet-desktop-left.webp";
import braceletDesktopRight from "../assets/images/channels/bracelet-desktop-right.webp";
import braceletMobileLeft from "../assets/images/channels/bracelet-mobile-left.webp";
import braceletMobileRight from "../assets/images/channels/bracelet-mobile-right.webp";
import Container from "../components/container.astro";

interface ChannelLink {
  href: string;
  title: string;
  hint: string;
  image: ImageMetadata;
}

const channels: ChannelLink[] = [
  {
    href: "#",
    title: "События и мероприятия",
    hint: "в Интранете",
    image: channelImg1,
  },
  {
    href: "#",
    title: "Льготы",
    hint: "в Интранете",
    image: channelImg2,
  },
  {
    href: "#",
    title: "Семья и дети",
    hint: "в Интранете",
    image: channelImg3,
  },
  {
    href: "#",
    title: "Семья и дети",
    hint: "в VK WorkSpace",
    image: channelImg4,
  },
];
---

<section id="channels" class="channels">
  <Container>
    <div class="channels__head">
      <Title>Каналы</Title>
      <Description>
        Подписывайтесь на каналы, чтобы не искать анонсы вручную
      </Description>
    </div>
  </Container>

  <div class="channels__body">
    <div class="channels__bg-1">
      <picture>
        <source media="(width >= 960px)" srcset={braceletDesktopLeft.src} />
        <img src={braceletMobileLeft.src} alt="" />
      </picture>
    </div>
    <div class="channels__bg-2">
      <picture>
        <source media="(width >= 960px)" srcset={braceletDesktopRight.src} />
        <img src={braceletMobileRight.src} alt="" />
      </picture>
    </div>

    {
      channels.map(({ href, title, hint, image }) => (
        <div class="channel">
          <div class="channel__img">
            <Image src={image} alt={title} />
          </div>
          <div class="channel__body">
            <h4>{title}</h4>
            <p>{hint}</p>
          </div>
          <a href={href} target="_blank">
            {title}
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .channels {
    padding-top: 90px;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      padding-top: 130px;
    }

    & .channels__head {
      display: grid;
      gap: var(--space24);

      /* desktop */
      @media (width >= 960px) {
        gap: var(--space32);
      }
    }

    & .channels__body {
      position: relative;
      margin-top: var(--space32);
      margin-inline: auto;
      aspect-ratio: 796 / 1096;
      height: 398px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: var(--space);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space48);
        height: 600px;
        padding: 48px;
      }

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("../assets/images/channels/phone.webp");
        background-position: center bottom;
        background-size: auto 100%;
        background-repeat: no-repeat;
        z-index: 1;
      }

      .channels__bg-1,
      .channels__bg-2 {
        position: absolute;
        pointer-events: none;

        picture,
        img {
          display: block;
          width: 100%;
          height: auto;
        }
      }

      .channels__bg-1 {
        width: 458px;
        top: 10%;
        right: calc(100% - 20px);

        /* desktop */
        @media (width >= 960px) {
          top: -25%;
          width: 803px;
        }
      }

      .channels__bg-2 {
        width: 385px;
        top: -10%;
        left: calc(100% - 20px);

        /* desktop */
        @media (width >= 960px) {
          top: -40%;
          width: 688px;
        }
      }

      .channel {
        position: relative;
        z-index: 1;
        display: grid;
        gap: var(--space8);
        grid-template-columns: 45px 1fr;
        box-shadow: 0 7px 6.55px 0 #00000040;
        background:
          linear-gradient(
            0deg,
            rgba(222, 199, 255, 0.25),
            rgba(222, 199, 255, 0.25)
          ),
          linear-gradient(
            170.56deg,
            #ffffff 31.27%,
            rgba(255, 255, 255, 0) 105.23%
          );
        backdrop-filter: blur(6px);
        border-radius: 26px;
        padding: var(--space);
        align-items: center;
        overflow: hidden;
        transition: backdrop-filter var(--transition);

        /* desktop */
        @media (width >= 960px) {
          border-radius: 50px;
          grid-template-columns: 84px 1fr;
          gap: var(--space16);
          padding: 6px;
        }

        &:hover {
          backdrop-filter: blur(2px);

          .channel__img {
            filter: hue-rotate(60deg);
          }
        }

        & .channel__img {
          width: 45px;
          height: 45px;
          border-radius: 50%;
          transition: filter var(--transition);

          /* desktop */
          @media (width >= 960px) {
            width: 84px;
            height: 84px;
          }

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }
        }

        & .channel__body {
          display: grid;
          gap: 2px;

          /* desktop */
          @media (width >= 960px) {
            gap: var(--space);
          }

          h4 {
            font-weight: 500;
            font-size: 8.66px;
            line-height: 100%;

            /* desktop */
            @media (width >= 960px) {
              font-size: 16px;
            }
          }

          p {
            font-weight: 500;
            font-size: 7.58px;
            line-height: 100%;
            color: var(--color-text-secondary);

            /* desktop */
            @media (width >= 960px) {
              font-size: 14px;
            }
          }
        }

        a {
          position: absolute;
          font-size: 0;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
        }
      }
    }
  }
</style>
