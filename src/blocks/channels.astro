---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Title from "../components/title.astro";
import Description from "../components/description.astro";

import channelImg1 from "../assets/images/channels/channel-1.webp";
import channelImg2 from "../assets/images/channels/channel-2.webp";
import channelImg3 from "../assets/images/channels/channel-3.webp";
import channelImg4 from "../assets/images/channels/channel-4.webp";
import braceletDesktopLeft from "../assets/images/channels/bracelet-desktop-left.webp";
import braceletDesktopRight from "../assets/images/channels/bracelet-desktop-right.webp";
import braceletMobileLeft from "../assets/images/channels/bracelet-mobile-left.webp";
import braceletMobileRight from "../assets/images/channels/bracelet-mobile-right.webp";
import Container from "../components/container.astro";

interface ChannelLink {
  href: string;
  title: string;
  hint: string;
  image: ImageMetadata;
}

const channels: ChannelLink[] = [
  {
    href: "https://home.vk.team/blog/events-for-employees/",
    title: "События и мероприятия",
    hint: "в Интранете",
    image: channelImg1,
  },
  {
    href: "https://home.vk.team/blog/health/",
    title: "Льготы",
    hint: "в Интранете",
    image: channelImg2,
  },
  {
    href: "https://home.vk.team/blog/family/",
    title: "Семья и дети",
    hint: "в Интранете",
    image: channelImg3,
  },
  {
    href: "https://u.internal.myteam.mail.ru/profile/family",
    title: "Семья и дети",
    hint: "в VK WorkSpace",
    image: channelImg4,
  },
];
---

<section id="channels" class="channels">
  <Container>
    <div class="channels__head">
      <Title>Каналы</Title>
      <Description>
        Подписывайтесь на&nbsp;каналы, чтобы не&nbsp;искать анонсы вручную
      </Description>
    </div>
  </Container>

  <div class="channels__body">
    <div class="channels__bg-1">
      <picture>
        <source media="(width >= 960px)" srcset={braceletDesktopLeft.src} />
        <img src={braceletMobileLeft.src} alt="" />
      </picture>
    </div>
    <div class="channels__bg-2">
      <picture>
        <source media="(width >= 960px)" srcset={braceletDesktopRight.src} />
        <img src={braceletMobileRight.src} alt="" />
      </picture>
    </div>

    {
      channels.map(({ href, title, hint, image }) => (
        <div class="channel">
          <div class="channel__img">
            <Image src={image} alt={title} />
          </div>
          <div class="channel__body">
            <h4>{title}</h4>
            <p>{hint}</p>
          </div>
          <a href={href} target="_blank">
            {title}
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .channels {
    padding-top: 94px;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      padding-top: 130px;
    }

    & .channels__head {
      display: grid;
      gap: 22px;

      /* desktop */
      @media (width >= 960px) {
        gap: var(--space32);
      }
    }

    & .channels__body {
      position: relative;
      margin-top: var(--space20);
      margin-bottom: -8px;
      margin-inline: auto;
      aspect-ratio: 786 / 1114;
      height: 310px;
      padding: 75px 20px 0;
      display: flex;
      flex-direction: column;

      /* desktop */
      @media (width >= 960px) {
        margin-top: 80px;
        height: 560px;
        padding: 132px 34px 0 36px;
        margin-bottom: -44px;
      }

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("../assets/images/channels/phone.webp");
        background-position: center bottom;
        background-size: auto 100%;
        background-repeat: no-repeat;
        z-index: 1;
      }

      .channels__bg-1,
      .channels__bg-2 {
        position: absolute;
        pointer-events: none;

        picture,
        img {
          display: block;
          width: 100%;
          height: auto;
        }
      }

      .channels__bg-1 {
        width: 458px;
        top: -5%;
        right: calc(100% - 59px);

        /* tablet */
        @media (width >= 768px) {
          right: calc(100% - 32px);
        }

        /* desktop */
        @media (width >= 960px) {
          top: -12%;
          right: calc(100% - 7px);
          width: 600px;
        }

        /* widescreen */
        @media (width >= 1200px) {
          top: -19%;
          width: 803px;
        }

        /* fullhd */
        @media (width >= 1600px) {
          top: -20%;
          width: calc((100vw - 395px) / 2 + 20px);
        }
      }

      .channels__bg-2 {
        width: 385px;
        top: -26%;
        left: calc(100% - 67px);

        /* tablet */
        @media (width >= 768px) {
          top: -16%;
          left: calc(100% - 4px);
        }

        /* desktop */
        @media (width >= 960px) {
          top: -32%;
          left: calc(100% - 48px);
          width: 688px;
        }

        /* widescreen */
        @media (width >= 1200px) {
          top: -44%;
          left: calc(100% - 12px);
        }

        /* fullhd */
        @media (width >= 1600px) {
          top: -32px;
          width: calc((100vw - 395px) / 2 + 20px);
        }
      }

      .channel {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 12px;
        grid-template-columns: 45px 1fr;
        background:
          linear-gradient(
            0deg,
            rgba(222, 199, 255, 0.25),
            rgba(222, 199, 255, 0.25)
          ),
          linear-gradient(
            170.56deg,
            #ffffff 31.27%,
            rgba(255, 255, 255, 0) 105.23%
          );
        padding: var(--space);
        align-items: center;
        overflow: hidden;

        /* desktop */
        @media (width >= 960px) {
          grid-template-columns: 84px 1fr;
          gap: 15px;
          padding: 6px 10% 6px 5px;
        }

        &:hover {
          backdrop-filter: blur(2px);
          letter-spacing: 1px;

          .channel__img {
            filter: hue-rotate(60deg);
          }
        }

        & .channel__img {
          width: 49px;
          height: 49px;
          border-radius: 50%;
          transition: filter var(--transition);

          /* desktop */
          @media (width >= 960px) {
            width: 84px;
            height: 84px;
          }

          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }
        }

        & .channel__body {
          display: grid;
          gap: 4px;
          padding-right: 4px;

          /* desktop */
          @media (width >= 960px) {
            gap: var(--space);
          }

          h4 {
            font-weight: 500;
            font-size: 9.29px;
            line-height: 1.2em;
            transition: letter-spacing var(--transition);

            /* desktop */
            @media (width >= 960px) {
              font-size: 16px;
            }
          }

          p {
            font-weight: 500;
            font-size: 8.13px;
            line-height: 1.2em;
            color: var(--color-text-secondary);
            transition: letter-spacing var(--transition);

            /* desktop */
            @media (width >= 960px) {
              font-size: 14px;
            }
          }
        }

        a {
          position: absolute;
          font-size: 0;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
        }
      }
    }
  }
</style>
