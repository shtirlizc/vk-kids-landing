---
import Title from "../../components/title.astro";
import Container from "../../components/container.astro";
import { categories, services } from "./data.ts";
import Card from "./card.astro";

const serviceCategories = Object.entries(services);
---

<section id="services" class="services">
  <Container>
    <Title>Сервисы и возможности</Title>

    <div class="services__nav-wrapper">
      <ul class="services__nav" aria-label="Категории сервисов">
        {
          serviceCategories.map(([key], index) => (
            <li>
              <button
                class="badge"
                type="button"
                data-category-index={index}
                aria-pressed="false"
              >
                {categories[key as keyof typeof categories]}
              </button>
            </li>
          ))
        }
      </ul>
      <div class="services__swiper-nav">
        <button class="swiper-nav prev small">Предыдущий</button>
        <button class="swiper-nav next small">Следующий</button>
      </div>
    </div>
  </Container>

  <div class="services__body">
    <div class="swiper services-categories-swiper">
      <div class="swiper-wrapper">
        {
          serviceCategories.map(([key, items]) => (
            <div class="swiper-slide services__category" data-category={key}>
              <div class="swiper services-swiper">
                <div class="swiper-wrapper">
                  {items.map((service) => (
                    <div class="swiper-slide">
                      <Card service={service} category={key} />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    border-radius: 32px;
    padding: var(--space36) 0;
    background-color: var(--color-bg-grey);

    /* desktop */
    @media (width >= 960px) {
      border-radius: 86px;
      padding: 90px 0 74px;
    }

    & .services__nav-wrapper {
      margin-top: 21px;

      /* desktop */
      @media (width >= 960px) {
        position: relative;
        margin-top: 50px;
        padding: 0 120px;
      }
    }

    & .services__swiper-nav {
      display: none;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        gap: var(--space24);
      }
    }

    & .services__nav {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space8);

      /* desktop */
      @media (width >= 960px) {
        gap: 10px;
      }
    }

    & .services__body {
      margin-top: var(--space28);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space32);
      }

      .services-swiper .swiper-wrapper {
        padding: 0 var(--container-padding);

        /* fullhd */
        @media (width >= 1600px) {
          padding: 0
            calc((100vw - var(--container)) / 2 + var(--container-padding));
        }
      }

      .services-swiper .swiper-slide {
        /* desktop */
        @media (width >= 960px) {
          width: 558px;
        }
      }

      .services__category {
        &.swiper-slide-active .services-swiper .swiper-slide {
          pointer-events: auto;
        }
      }
    }
  }
</style>

<script>
  import { Swiper } from "swiper";
  import { EffectFade, FreeMode } from "swiper/modules";
  import "swiper/css/effect-fade";
  import { categoryQueryParameter } from "./data.ts";
  import { setCategoryInUrl } from "./category-url.ts";

  const locationChangeEvent = "services:location-change";
  type HistoryMethodName = "pushState" | "replaceState";
  type ObservableHistory = Pick<History, HistoryMethodName> & {
    servicesLocationEventsPatched?: boolean;
  };

  const observableHistory = window.history as unknown as ObservableHistory;

  if (!observableHistory.servicesLocationEventsPatched) {
    (["pushState", "replaceState"] as const).forEach((method) => {
      const originalMethod = observableHistory[method];

      observableHistory[method] = (...args) => {
        originalMethod.apply(window.history, args);
        window.dispatchEvent(new Event(locationChangeEvent));
      };
    });

    observableHistory.servicesLocationEventsPatched = true;
  }

  const servicesSection = document.querySelector<HTMLElement>(".services");

  if (servicesSection) {
    const innerSwipers = new Map<string, Swiper>();
    const categorySlides = servicesSection.querySelectorAll<HTMLElement>(
      ".services-categories-swiper > .swiper-wrapper > .swiper-slide",
    );
    const categoryButtons = servicesSection.querySelectorAll<HTMLButtonElement>(
      ".services__nav [data-category-index]",
    );
    const prevButton = servicesSection.querySelector<HTMLButtonElement>(
      ".services__swiper-nav .prev",
    );
    const nextButton = servicesSection.querySelector<HTMLButtonElement>(
      ".services__swiper-nav .next",
    );

    servicesSection
      .querySelectorAll<HTMLElement>(".services__body .services-swiper")
      .forEach((element) => {
        const category =
          element.closest<HTMLElement>("[data-category]")?.dataset.category;
        const swiper = new Swiper(element, {
          modules: [FreeMode],
          loop: true,
          loopAdditionalSlides: 2,
          nested: true,
          breakpoints: {
            320: {
              freeMode: false,
              slidesPerView: 1.2,
              spaceBetween: 10,
            },
            560: {
              freeMode: false,
              slidesPerView: 2,
              spaceBetween: 10,
            },
            960: {
              freeMode: true,
              slidesPerView: "auto",
              spaceBetween: 20,
            },
          },
        });

        if (category) {
          innerSwipers.set(category, swiper);
        }
      });

    const categoriesSwiperElement = servicesSection.querySelector<HTMLElement>(
      ".services-categories-swiper",
    );

    if (categoriesSwiperElement) {
      const getCategoryIndex = (category: string | null) =>
        Array.from(categorySlides).findIndex(
          (slide) => slide.dataset.category === category,
        );
      const getCategoryIndexFromLocation = () => {
        const category = new URL(window.location.href).searchParams.get(
          categoryQueryParameter,
        );
        const categoryIndex = getCategoryIndex(category);

        return categoryIndex >= 0 ? categoryIndex : 0;
      };
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const fadeDuration = prefersReducedMotion ? 0 : 500;
      const categoriesSwiper = new Swiper(categoriesSwiperElement, {
        modules: [EffectFade],
        effect: "fade",
        fadeEffect: { crossFade: true },
        speed: fadeDuration,
        slidesPerView: 1,
        initialSlide: getCategoryIndexFromLocation(),
        allowTouchMove: false,
        autoHeight: true,
      });

      const updateControls = () => {
        const { activeIndex } = categoriesSwiper;

        categoryButtons.forEach((button, index) => {
          const isActive = index === activeIndex;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
      };

      const getActiveInnerSwiper = () => {
        const activeCategory =
          categorySlides[categoriesSwiper.activeIndex]?.dataset.category;

        return activeCategory ? innerSwipers.get(activeCategory) : undefined;
      };

      const selectCategory = (index: number, updateUrl = false) => {
        if (index < 0 || index >= categorySlides.length) return;

        if (updateUrl) {
          const category = categorySlides[index]?.dataset.category;

          if (category) {
            setCategoryInUrl(category);
          }
        }

        if (categoriesSwiper.activeIndex !== index) {
          categoriesSwiper.slideTo(index);
        }
      };

      const selectCategoryFromLocation = () => {
        selectCategory(getCategoryIndexFromLocation());
      };

      categoriesSwiper.on("slideChange", () => {
        const previousCategory =
          categorySlides[categoriesSwiper.previousIndex]?.dataset.category;

        if (previousCategory) {
          window.setTimeout(() => {
            const activeCategory =
              categorySlides[categoriesSwiper.activeIndex]?.dataset.category;

            if (activeCategory !== previousCategory) {
              innerSwipers.get(previousCategory)?.slideToLoop(0, 0);
            }
          }, fadeDuration);
        }

        updateControls();
      });

      categoriesSwiper.on("slideChangeTransitionEnd", () => {
        getActiveInnerSwiper()?.update();
      });

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectCategory(Number(button.dataset.categoryIndex), true);
        });
      });

      window.addEventListener("popstate", selectCategoryFromLocation);
      window.addEventListener(locationChangeEvent, selectCategoryFromLocation);

      prevButton?.addEventListener("click", () =>
        getActiveInnerSwiper()?.slidePrev(),
      );
      nextButton?.addEventListener("click", () =>
        getActiveInnerSwiper()?.slideNext(),
      );

      updateControls();
    }
  }
</script>
