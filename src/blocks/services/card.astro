---
import type { Card } from "./data.ts";
import Link from "../../components/link.astro";

interface Props {
  service: Card;
  category: string;
}

const { service, category } = Astro.props;
const { title, description, label, image, action } = service;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const imgSrc = `${baseUrl}images/${category}/${image}.webp`;
---

<div class="card">
  <div class="card__intro">
    <div class="card__text">
      <p>{label}</p>
      <h4>{title}</h4>
    </div>
    <div class="card__img">
      <img src={imgSrc} alt={title} loading="lazy" />
    </div>
  </div>

  <div class="card__description">
    <Fragment set:html={description} />
  </div>

  <div class="card__foot">
    {
      action && (
        <Link
          block
          href={action.type === "link" ? action.href : undefined}
          dataTabId={action.type === "tab" ? action.tabId : undefined}
        >
          {action.label}
        </Link>
      )
    }
  </div>
</div>

<style>
  .card {
    background-color: var(--color-bg-main);
    border-radius: 32px;
    padding: var(--space16);

    /* desktop */
    @media (width >= 960px) {
      aspect-ratio: 558 / 566;
      display: grid;
      grid-template-rows: auto 1fr auto;
    }

    & .card__intro {
      position: relative;
      background-color: var(--color-bg-primary-light);
      border-radius: 16px;
      padding: 14px 0 0 14px;
      display: grid;
      gap: var(--space24);
      overflow: hidden;

      /* desktop */
      @media (width >= 960px) {
        grid-template-columns: 1fr 1fr;
        gap: 0;
        padding: 0 0 0 14px;
        min-height: 148px;
      }

      .card__text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;

        /* desktop */
        @media (width >= 960px) {
          padding-top: 14px;
          gap: var(--space24);
          margin-right: -80px;
        }
      }

      p {
        font-family: var(--font-vk-text), sans-serif;
        font-weight: 600;
        font-size: 12px;
        line-height: 115%;
        letter-spacing: -4%;
        text-transform: uppercase;
        background-color: var(--color-bg-primary);
        padding: calc(var(--space) + 2px) var(--space12)
          calc(var(--space) - 2px);
        border-radius: 12px;
      }

      h4 {
        font-weight: 700;
        font-size: 18px;
        line-height: 1.05em;
        min-height: 2.1em;

        /* desktop */
        @media (width >= 960px) {
          font-size: 24px;
        }
      }

      .card__img {
        font-size: 0;
        display: flex;
        justify-content: flex-end;

        img {
          width: auto;
          height: 120px;

          /* desktop */
          @media (width >= 960px) {
            position: absolute;
            right: 0;
            bottom: 0;
            width: auto;
            height: auto;
            max-width: none;
            max-height: none;
            transform: scale(0.5);
            transform-origin: right bottom;
          }
        }
      }
    }

    & .card__description {
      margin-top: var(--space16);
      display: flex;
      flex-direction: column;
      gap: var(--space12);

      /* desktop */
      @media (width >= 960px) {
        overflow-x: hidden;
        overflow-y: auto;
      }

      p {
        font-weight: 500;
        font-size: 14px;
        line-height: 125%;

        /* desktop */
        @media (width >= 960px) {
          font-size: 16px;
        }
      }

      ol,
      ul {
        margin: var(--space8) 0;
        display: grid;
        gap: var(--space12);
        padding-left: var(--space16);

        li {
          font-weight: 500;
          font-size: 14px;
          line-height: 100%;

          /* desktop */
          @media (width >= 960px) {
            font-size: 16px;
          }
        }
      }

      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color var(--transition);

        &:hover {
          color: var(--color-primary);
        }
      }
    }

    & .card__foot {
      margin-top: var(--space24);
    }
  }
</style>

<script>
  import { setCategoryInUrl } from "./category-url.ts";

  document
    .querySelectorAll<HTMLButtonElement>(".card .link[data-tab-id]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const tabId = button.dataset.tabId;

        if (!tabId) return;

        setCategoryInUrl(tabId);
      });
    });
</script>
