---
import type { Card } from "./data.ts";
import Link from "../../components/link.astro";

interface Props {
  service: Card;
}

const { service } = Astro.props;
const { title, description, label, image, action } = service;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const imgSrc = `${baseUrl}images/benefits/${image}.webp`;
---

<div class="card">
  <div class="card__intro">
    <div class="card__text">
      <p>{label}</p>
      <h4>{title}</h4>
    </div>
    <div class="card__img">
      <img src={imgSrc} alt={title} loading="lazy" />
    </div>
  </div>

  <div class="card__description">
    <Fragment set:html={description} />
  </div>

  <div class="card__foot">
    <Link
      block
      href={action.type === "link" ? action.href : undefined}
      id={action.type === "tab" ? action.tabId : undefined}
    >
      {action.label}
    </Link>
  </div>
</div>

<style>
  .card {
    background-color: var(--color-bg-main);
    border-radius: 32px;
    padding: var(--space16);

    /* desktop */
    @media (width >= 960px) {
      aspect-ratio: 558 / 566;
      display: grid;
      grid-template-rows: auto 1fr auto;
    }

    & .card__intro {
      position: relative;
      background-color: var(--color-bg-primary-light);
      border-radius: 16px;
      padding: 14px 14px 0;
      display: grid;
      gap: var(--space24);
      overflow: hidden;

      /* desktop */
      @media (width >= 960px) {
        grid-template-columns: 1fr 1fr;
        gap: 0;
      }

      .card__text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;

        /* desktop */
        @media (width >= 960px) {
          gap: var(--space24);
          margin-right: -80px;
        }
      }

      p {
        font-family: var(--font-vk-text), sans-serif;
        font-weight: 600;
        font-size: 12px;
        line-height: 115%;
        letter-spacing: -4%;
        text-transform: uppercase;
        background-color: var(--color-bg-primary);
        padding: calc(var(--space) + 2px) var(--space12)
          calc(var(--space) - 2px);
        border-radius: 12px;
      }

      h4 {
        font-weight: 700;
        font-size: 18px;
        line-height: 1.05em;
        min-height: 2.1em;

        /* desktop */
        @media (width >= 960px) {
          font-size: 24px;
        }
      }

      .card__img {
        font-size: 0;
        display: flex;
        justify-content: flex-end;

        img {
          width: auto;
          height: 120px;

          /* desktop */
          @media (width >= 960px) {
            height: 147px;
          }
        }
      }
    }

    & .card__description {
      margin-top: var(--space16);
      display: flex;
      flex-direction: column;
      gap: var(--space12);

      /* desktop */
      @media (width >= 960px) {
        overflow-x: hidden;
        overflow-y: auto;
      }

      p {
        font-weight: 500;
        font-size: 14px;
        line-height: 125%;

        /* desktop */
        @media (width >= 960px) {
          font-size: 16px;
        }
      }
    }

    & .card__foot {
      margin-top: var(--space24);
    }
  }
</style>
