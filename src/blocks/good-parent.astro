---
import Container from "../components/container.astro";
import Link from "../components/link.astro";
import Title from "../components/title.astro";

import mobileImg from "../assets/images/good-parent/mobile.webp";
import desktopImg from "../assets/images/good-parent/desktop.webp";
---

<Container>
  <section class="good-parent">
    <div class="good-parent__info">
      <Title isCentered={false}>Достаточно хороший родитель</Title>
      <p class="good-parent__description">
        Идеальных родителей не&nbsp;существует! Этот курс — о&nbsp;реальной
        жизни с&nbsp;детьми: как совмещать разные роли и&nbsp;не&nbsp;требовать
        от&nbsp;себя невозможного
      </p>
      <div class="good-parent__start">
        <Link
          href="https://vkube.vkteam.ru/courses/2894/"
          view="secondary"
          block
          size="l"
        >
          Начать
        </Link>
      </div>
    </div>

    <div class="good-parent__picture">
      <picture>
        <source media="(min-width: 960px)" srcset={desktopImg.src} />
        <img src={mobileImg.src} alt="" />
      </picture>
    </div>
  </section>
</Container>

<style>
  .good-parent {
    margin: 90px 0;
    background-image: linear-gradient(180deg, #40cbff 0%, #b4f0ff 100%);
    border-radius: 20px;
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space20);
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      display: grid;
      grid-template-columns: 3fr 5fr;
      border-radius: 48px;
    }

    & .good-parent__info {
      padding: var(--space20);
      display: flex;
      flex-direction: column;
      gap: 22px;
      margin-top: -127px;

      /* desktop */
      @media (width >= 960px) {
        padding: 43px 45px 46px;
        justify-content: space-between;
        margin-top: 0;
        gap: var(--space40);
      }
    }

    & .good-parent__description {
      font-weight: 500;
      font-size: 15px;
      line-height: 1.25em;

      /* desktop */
      @media (width >= 960px) {
        font-size: 24px;
        line-height: 1.3em;
      }
    }

    & .good-parent__start {
      /* desktop */
      @media (width >= 960px) {
        max-width: 276px;
      }
    }

    & .good-parent__picture {
      font-size: 0;

      /* desktop */
      @media (width >= 960px) {
        display: flex;
        justify-content: flex-end;
      }

      img {
        width: 100%;
        height: auto;

        /* desktop */
        @media (width >= 960px) {
          height: 100%;
          object-fit: cover;
          object-position: left center;
        }
      }
    }
  }
</style>
