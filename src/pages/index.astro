---
import Head from "../components/head.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Hero from "../blocks/hero.astro";
import Competition from "../blocks/competition.astro";
import News from "../blocks/news.astro";
import GoodParent from "../blocks/good-parent.astro";
import Services from "../blocks/services.astro";
import Channels from "../blocks/channels.astro";
import Faq from "../blocks/faq/faq.astro";
---

<html lang="ru">
  <Head />
  <body>
    <Header />

    <main>
      <Hero />
      <Competition />
      <News />
      <GoodParent />
      <Services />
      <Channels />
    </main>

    <div class="foot">
      <Faq />
      <Footer />
    </div>
  </body>
</html>

<style>
  .foot {
    border-radius: 32px 32px 0 0;
    background: var(--bg-gradient);

    /* desktop */
    @media (width >= 960px) {
      border-radius: 48px 48px 0 0;
      background-image:
        url(../assets/images/faq/fish.webp),
        url(../assets/images/faq/bracelet-desktop-2.webp), var(--bg-gradient);
      background-repeat: no-repeat;
      background-position:
        right top,
        left 40%,
        center;
      background-size:
        392px auto,
        392px auto,
        cover;
    }
  }
</style>
